<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# referenced assembly of one friendship variant of
       `friend_assembly_grid`: its IL-only internal types. `Generated.cs` is
       emitted by the test and is not checked in. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>FriendGridCsUndecodable</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- The undecodable variant declares its own InternalsVisibleToAttribute. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

</Project>
