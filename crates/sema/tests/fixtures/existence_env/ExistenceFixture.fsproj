<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fixture for the existence index differential
       (`assembly_entities_diff`): every entity kind F# declares, at every
       accessibility, so the index is held to FCS and to
       System.Reflection.Metadata on what name resolution's view filters
       out. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SemaExistenceFixture</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixture.fs" />
  </ItemGroup>

</Project>
