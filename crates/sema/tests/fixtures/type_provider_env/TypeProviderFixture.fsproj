<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fixture for the project oracles' type-provider refusal
       (tests/all/uses_project_smoke.rs): a library that declares itself a
       type provider's runtime assembly, naming a design-time assembly that
       does not exist. The oracles must refuse a project referencing it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SemaTypeProviderFixture</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixture.fs" />
  </ItemGroup>

</Project>
