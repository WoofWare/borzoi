<Project Sdk="Microsoft.NET.Sdk">

  <!-- The referenced assembly of `infer_assembly_extension_grid`: one
       namespace per cell of the grid, each declaring a receiver and an
       extension member of one shape. `Generated.fs` is emitted by the test
       from the grid's dimensions and is not checked in. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ExtAssemblyGridFixture</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Generated.fs" />
  </ItemGroup>

</Project>
